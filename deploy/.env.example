# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default): leave unset or set to a sqlite:// URL for per-user split DBs.
# Postgres: set to postgres://user:password@host:5432/dbname to enable single-DB mode.
# Required in Postgres mode; optional in SQLite mode.
DATABASE_URL=

# ── Auth & JWT ────────────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. Must be a long random string.
# Required.
JWT_SECRET=

# Refresh token lifetime in seconds (default: 2592000 = 30 days).
# Optional.
REFRESH_TOKEN_TTL_SECS=2592000

# ── OIDC / OAuth ──────────────────────────────────────────────────────────────
# OIDC provider issuer URL (e.g. https://accounts.google.com).
# Required when using OIDC login.
OIDC_ISSUER_URL=

# OIDC client ID issued by the identity provider.
# Required when using OIDC login.
OIDC_CLIENT_ID=

# OIDC client secret issued by the identity provider.
# Required when using OIDC login.
OIDC_CLIENT_SECRET=

# Public-facing URL for this deployment, used to build the OIDC redirect URI.
# Required when using OIDC login.
OIDC_PROVIDER_PUBLIC_URL=

# ── Mail Provider OAuth ───────────────────────────────────────────────────────
# Public-facing backend URL used to build Gmail/Outlook OAuth redirect URIs.
# Example callbacks:
#   ${APP_BASE_URL}/api/auth/oauth/google/callback
#   ${APP_BASE_URL}/api/auth/oauth/microsoft/callback
# Optional; defaults to http://localhost:8080.
APP_BASE_URL=

# Gmail OAuth client credentials.
# Required when connecting Gmail accounts through OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Outlook/Microsoft OAuth client credentials.
# Required when connecting Outlook or Microsoft 365 accounts through OAuth.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Remote Mail Images ───────────────────────────────────────────────────────
# Proxy approved remote email images through the backend instead of loading
# them directly in the browser. Useful for deployments with browser TLS/CSP
# constraints, but disabled by default.
REMOTE_IMAGE_PROXY_ENABLED=false

# ── Web Push / VAPID ──────────────────────────────────────────────────────────
# VAPID public key (base64url, 65 bytes uncompressed). Generated via:
#   openssl ecparam -genkey -name prime256v1 | openssl pkcs8 -topk8 -nocrypt | ...
# Required for push notifications.
VAPID_PUBLIC_KEY=

# VAPID private key (base64url, 32 bytes). Keep secret.
# Required for push notifications.
VAPID_PRIVATE_KEY=

# VAPID subject — mailto: or https: URI identifying the push sender.
# Required for push notifications.
VAPID_SUBJECT=mailto:admin@example.com

# ── Blob Storage ──────────────────────────────────────────────────────────────
# Backend for storing message bodies and attachments.
# Values: local (default) | s3
# Optional; defaults to "local".
BLOB_BACKEND=local

# Filesystem path for local blob storage (used when BLOB_BACKEND=local).
# Required when BLOB_BACKEND=local.
BLOB_LOCAL_PATH=./data/blobs

# S3 bucket name (used when BLOB_BACKEND=s3).
# Required when BLOB_BACKEND=s3.
S3_BUCKET=

# S3-compatible endpoint URL. Leave unset for AWS S3.
# Set to override for MinIO, Backblaze B2, Cloudflare R2, etc.
# Optional; defaults to AWS S3.
S3_ENDPOINT=

# AWS region (used when BLOB_BACKEND=s3).
# Required when BLOB_BACKEND=s3.
S3_REGION=

# AWS access key ID (used when BLOB_BACKEND=s3).
# Required when BLOB_BACKEND=s3.
AWS_ACCESS_KEY_ID=

# AWS secret access key (used when BLOB_BACKEND=s3).
# Required when BLOB_BACKEND=s3.
AWS_SECRET_ACCESS_KEY=

# ── Blob Encryption ───────────────────────────────────────────────────────────
# Enable AES-256-GCM encryption for all blob storage writes.
# Values: true | false (default: false)
# Optional.
BLOB_ENCRYPTION=false

# 64 hex characters (32 bytes) AES-256 key for blob encryption.
# Required when BLOB_ENCRYPTION=true. Generate with: mailquill secrets
# (reuse any 64-hex key it prints).
BLOB_ENCRYPTION_KEY=

# ── Credential Encryption ─────────────────────────────────────────────────────
# Key used to encrypt IMAP/SMTP credentials stored in the database.
# 64 hex characters (32 bytes). Generate with: mailquill secrets
# Required.
CREDENTIAL_ENCRYPTION_KEY=

# ── PII Logging ───────────────────────────────────────────────────────────────
# Controls how PII (email addresses, names, subjects) appears in logs.
# Values: remove (default) | hash | encrypt | plaintext
# remove    — all PII replaced with [REDACTED] (production default)
# hash      — deterministic sha256 prefix for ops correlation
# encrypt   — AES-GCM encrypted, reversible with LOG_PII_KEY
# plaintext — raw values logged (development only; emits stderr warning)
# Optional; defaults to "remove".
LOG_PII_MODE=remove

# AES-256 key for LOG_PII_MODE=encrypt. 64 hex characters (32 bytes).
# Required when LOG_PII_MODE=encrypt. Generate with: mailquill secrets
# (reuse any 64-hex key it prints).
LOG_PII_KEY=
